範例 02  統計活動報名項目
目錄  ChatGPT/Example2
使用 java.util.LinkedHashMap，結果依首次出現順序印出羽球 2、籃球 2、桌球 1。

檔案  RegistrationCounter.java
import java.util.Arrays;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class RegistrationCounter {
    public static void main(String[] args) {
        List<String> registrations = Arrays.asList("羽球", "籃球", " 羽球 ", "", "桌球", "籃球");
        Map<String, Integer> counts = new LinkedHashMap<>();

        for (String registration : registrations) {
            String event = registration.trim();
            if (!event.isEmpty()) {
                counts.merge(event, 1, Integer::sum);
            }
        }

        counts.forEach((event, count) -> System.out.println(event + "：" + count + " 人"));
    }
}

