import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

public class CH3P38 {
    public static void main(String[] args) throws IOException {
        BufferedReader reader = new BufferedReader(
                new InputStreamReader(System.in, StandardCharsets.UTF_8));

        System.out.println("請輸入字串");
        String text = reader.readLine();
        System.out.println("請輸入一個要搜尋的字元");
        String query = reader.readLine();
        if (text == null || query == null || query.codePointCount(0, query.length()) != 1) {
            System.out.println("請輸入原字串及一個要搜尋的字元");
            return;
        }
        int index = text.indexOf(query.codePointAt(0));
        if (index == -1) {
            System.out.println("找不到 " + query);
        } else {
            System.out.println("出現在第 " + (text.codePointCount(0, index) + 1) + " 個字元");
        }
    }
}

