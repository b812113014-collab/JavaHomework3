public class CH4P06 {
    public static void main(String[] args) {
        RacingCar car = new RacingCar(1234, 20.5, 5);
        car.show();
    }

    static class Car {
        protected int num;
        protected double gas;

        Car(int num, double gas) {
            setCar(num, gas);
            System.out.println("已建立車輛");
        }

        void setCar(int num, double gas) {
            this.num = num;
            this.gas = gas;
        }

        void show() {
            System.out.println("車號：" + num + "，汽油量：" + gas);
        }
    }

    static class RacingCar extends Car {
        private final int course;

        RacingCar(int num, double gas, int course) {
            super(num, gas);
            this.course = course;
            System.out.println("已建立編號 " + this.course + " 的賽車");
        }
    }
}

