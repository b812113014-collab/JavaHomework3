P52  觀察未同步的共用金額更新
目錄  CH5/P52
執行緒排程不同，可能出現低於 300 的結果，也可能剛好得到 300。

檔案  CH5P52.java
public class CH5P52 {
    public static void main(String[] args) throws InterruptedException {
        Company company = new Company();
        Thread first = new Driver(company);
        Thread second = new Driver(company);

        first.start();
        second.start();
        first.join();
        second.join();

        System.out.println("應有總額：300");
        System.out.println("實際總額：" + company.getSum());
    }

    static class Company {
        private int sum;

        void add(int amount) {
            int previous = sum;
            // 增加兩個執行緒讀到同一個舊值的機會。
            Thread.yield();
            sum = previous + amount;
        }

        int getSum() {
            return sum;
        }
    }

    static class Driver extends Thread {
        private final Company company;

        Driver(Company company) {
            this.company = company;
        }

        @Override
        public void run() {
            for (int i = 0; i < 3; i++) {
                company.add(50);
            }
        }
    }
}

