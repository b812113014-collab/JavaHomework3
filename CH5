public class CH5P30 {
    public static void main(String[] args) {
        Car car = new Car();
        try {
            car.setCar(1234, 20.5);
            car.setCar(5678, -10.0);
        } catch (CarException e) {
            System.out.println(e.getMessage());
        }
        car.show();
    }

    static class CarException extends Exception {
        CarException(String message) {
            super(message);
        }
    }

    static class Car {
        private int num;
        private double gas;

        void setCar(int num, double gas) throws CarException {
            if (gas < 0.0) {
                throw new CarException("汽油量不得小於零");
            }
            this.num = num;
            this.gas = gas;
        }

        void show() {
            System.out.println("車號：" + num + "，汽油量：" + gas);
        }
    }
}

