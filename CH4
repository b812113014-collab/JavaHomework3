public class CH4P41 {
    public static void main(String[] args) {
        Car car = new Car(1234, 20.5);
        car.vShow();
        car.mShow();
    }

    interface Vehicle {
        void vShow();
    }

    interface Material {
        void mShow();
    }

    static class Car implements Vehicle, Material {
        private final int num;
        private final double gas;

        Car(int num, double gas) {
            this.num = num;
            this.gas = gas;
        }

        @Override
        public void vShow() {
            System.out.println("車號：" + num + "，汽油量：" + gas);
        }

        @Override
        public void mShow() {
            System.out.println("材質：鐵");
        }
    }
}
