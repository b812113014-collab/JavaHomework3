public class CH4P29 {
    public static void main(String[] args) {
        Vehicle[] vehicles = {new Car(1234, 20.5), new Plane(232)};
        vehicles[0].setSpeed(60);
        vehicles[1].setSpeed(500);

        for (Vehicle vehicle : vehicles) {
            vehicle.show();
        }
    }

    abstract static class Vehicle {
        protected int speed;

        void setSpeed(int speed) {
            this.speed = speed;
        }

        abstract void show();
    }

    static class Car extends Vehicle {
        private final int num;
        private final double gas;

        Car(int num, double gas) {
            this.num = num;
            this.gas = gas;
        }

        @Override
        void show() {
            System.out.println("車號：" + num + "，汽油量：" + gas + "，速度：" + speed);
        }
    }

    static class Plane extends Vehicle {
        private final int flightNumber;

        Plane(int flightNumber) {
            this.flightNumber = flightNumber;
        }

        @Override
        void show() {
            System.out.println("班次：" + flightNumber + "，速度：" + speed);
        }
    }
}

