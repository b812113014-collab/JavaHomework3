範例 01  輸入並統計有效成績
目錄  ChatGPT/Example1
使用 java.util.Scanner 與 IntSummaryStatistics。依序輸入 80、90、101、abc、q，預期有效成績兩筆，平均 85.00。

檔案  ScoreSummary.java
import java.nio.charset.StandardCharsets;
import java.util.IntSummaryStatistics;
import java.util.Locale;
import java.util.Scanner;

public class ScoreSummary {
    public static void main(String[] args) {
        IntSummaryStatistics stats = new IntSummaryStatistics();
        System.out.println("輸入 0 到 100 的整數成績，輸入 q 結束。");

        try (Scanner scanner = new Scanner(System.in, StandardCharsets.UTF_8)) {
            while (scanner.hasNextLine()) {
                String line = scanner.nextLine().trim();
                if (line.equalsIgnoreCase("q")) {
                    break;
                }
                try {
                    int score = Integer.parseInt(line);
                    if (score < 0 || score > 100) {
                        System.out.println("成績必須介於 0 到 100。");
                        continue;
                    }
                    stats.accept(score);
                } catch (NumberFormatException e) {
                    System.out.println("請輸入整數或 q。");
                }
            }
        }

        if (stats.getCount() == 0) {
            System.out.println("沒有有效成績可統計。");
            return;
        }
        System.out.printf(Locale.ROOT, "筆數：%d，平均：%.2f，最低：%d，最高：%d%n",
                stats.getCount(), stats.getAverage(), stats.getMin(), stats.getMax());
    }
}

