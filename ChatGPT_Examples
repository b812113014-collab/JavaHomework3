範例 03  將學習紀錄寫入檔案並讀回
目錄  ChatGPT/Example3
使用 java.io.BufferedWriter 和 BufferedReader。執行會在目前目錄建立或覆寫 study-log.txt。

檔案  StudyLog.java
import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;

public class StudyLog {
    public static void main(String[] args) {
        Path file = Path.of("study-log.txt");

        try {
            try (BufferedWriter writer = Files.newBufferedWriter(file, StandardCharsets.UTF_8)) {
                writer.write("CH3：完成物件參考練習");
                writer.newLine();
                writer.write("CH5：完成檔案讀寫練習");
                writer.newLine();
            }

            try (BufferedReader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
                String line;
                while ((line = reader.readLine()) != null) {
                    System.out.println(line);
                }
            }
        } catch (IOException e) {
            System.err.println("無法處理 " + file.toAbsolutePath() + "：" + e.getMessage());
        }
    }
}
